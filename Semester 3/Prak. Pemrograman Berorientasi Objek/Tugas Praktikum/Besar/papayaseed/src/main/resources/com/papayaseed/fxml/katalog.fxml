<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.papayaseed.controllers.KatalogController">

    <top>
        <Label text="Katalog Bibit Pepaya"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e6952f; -fx-padding: 20;" />
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="productList"
                  spacing="20"
                  alignment="CENTER"
                  style="-fx-padding: 20;">
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
